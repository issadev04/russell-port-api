<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Port de plaisance Russell</title>
</head>
<body>
    <h1>Port de plaisance Russell</h1>

    <!-- Lien vers la documentation de l'API -->
    <p>
        <a href="/documentation">Documentation API</a>
    </p>

    <!-- Formulaire de connexion -->
    <h2>Connexion</h2>

    <form id="loginForm">
        <label for="email">Email</label>
        <input type="email" id="email" required>

        <label for="password">Mot de passe</label>
        <input type="password" id="password" required>

        <button type="submit">Se connecter</button>
    </form>

    <!-- Zone d'affichage du résultat de la connexion -->
    <p id="message"></p>

    <script>
        // Récupère le formulaire de connexion
        const loginForm = document.getElementById("loginForm");

        // Gère l'envoi du formulaire
        loginForm.addEventListener("submit", async (event) => {
            // Empêche le rechargement automatique de la page
            event.preventDefault();

            // Récupère les identifiants saisis
            const email = document.getElementById("email").value;
            const password = document.getElementById("password").value;

            // Envoie les identifiants à l'API pour authentification
            const response = await fetch("/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "include",
                body: JSON.stringify({
                    email,
                    password
                })
            });

            // Récupère la réponse JSON de l'API
            const data = await response.json();

            // Redirige vers le tableau de bord si la connexion réussit
            if (response.ok) {
                window.location.href = "/dashboard";
            } else {
                // Affiche le message d'erreur en cas d'échec
                document.getElementById("message").textContent = data.message;
            }
        });
    </script>
</body>
</html>