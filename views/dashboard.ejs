<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord - Port de plaisance Russell</title>
</head>

<body>

    <h1>Tableau de bord</h1>

    <nav>
        <a href="/dashboard">Tableau de bord</a>
        <a href="/dashboard/catways">Catways</a>
<a href="/dashboard/reservations">Réservations</a>
<a href="/dashboard/users">Utilisateurs</a>
        <a href="#">Documentation API</a>
        <a href="#" id="logout">Se déconnecter</a>
    </nav>

    <h2>Utilisateur connecté</h2>

    <p>Nom : <span id="username">-</span></p>
    <p>Email : <span id="email">-</span></p>
    <p>Date : <span id="date"></span></p>

    <h2>Réservations en cours</h2>

    <table border="1">
        <thead>
            <tr>
                <th>Catway</th>
                <th>Client</th>
                <th>Bateau</th>
                <th>Début</th>
                <th>Fin</th>
            </tr>
        </thead>

        <tbody id="reservations"></tbody>
    </table>

    <script>
    document.getElementById("date").textContent =
        new Date().toLocaleDateString("fr-FR");

    document.getElementById("username").textContent =
        "<%= user.username %>";

    document.getElementById("email").textContent =
        "<%= user.email %>";

    document.getElementById("logout").addEventListener("click", async (event) => {
        event.preventDefault();

        await fetch("/logout", {
            credentials: "include"
        });

        window.location.href = "/";
    });
</script>

</body>

</html>