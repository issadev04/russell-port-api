<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord - Port de plaisance Russell</title>
</head>
<body>
    <h1>Tableau de bord</h1>

    <!-- Menu de navigation du tableau de bord -->
    <nav>
        <a href="/dashboard">Tableau de bord</a>
        <a href="/dashboard/catways">Catways</a>
        <a href="/dashboard/reservations">Réservations</a>
        <a href="/dashboard/users">Utilisateurs</a>
        <a href="/documentation">Documentation API</a>
        <a href="#" id="logout">Se déconnecter</a>
    </nav>

    <!-- Informations sur l'utilisateur connecté -->
    <h2>Utilisateur connecté</h2>
    <p>Nom : <span id="username">-</span></p>
    <p>Email : <span id="email">-</span></p>
    <p>Date : <span id="date"></span></p>

    <!-- Tableau des réservations en cours -->
    <h2>Réservations en cours</h2>

    <table border="1">
        <thead>
            <tr>
                <th>Catway</th>
                <th>Client</th>
                <th>Bateau</th>
                <th>Début</th>
                <th>Fin</th>
            </tr>
        </thead>
        <tbody>
            <!-- Affiche un message si aucune réservation n'est disponible -->
            <% if (reservations.length === 0) { %>
                <tr>
                    <td colspan="5">Aucune réservation en cours.</td>
                </tr>
            <% } else { %>
                <!-- Parcourt les réservations pour afficher leurs informations -->
                <% reservations.forEach((reservation) => { %>
                    <tr>
                        <td><%= reservation.catwayNumber %></td>
                        <td><%= reservation.clientName %></td>
                        <td><%= reservation.boatName %></td>
                        <td><%= new Date(reservation.startDate).toLocaleDateString("fr-FR") %></td>
                        <td><%= new Date(reservation.endDate).toLocaleDateString("fr-FR") %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <script>
        // Affiche la date du jour au format français
        document.getElementById("date").textContent =
            new Date().toLocaleDateString("fr-FR");

        // Affiche le nom de l'utilisateur connecté
        document.getElementById("username").textContent =
            "<%= user.username %>";

        // Affiche l'adresse e-mail de l'utilisateur connecté
        document.getElementById("email").textContent =
            "<%= user.email %>";

        // Gère la déconnexion de l'utilisateur
        document.getElementById("logout")
            .addEventListener("click", async (event) => {
                // Empêche le lien de navigation de s'exécuter
                event.preventDefault();

                // Envoie une requête de déconnexion à l'API
                await fetch("/logout", {
                    credentials: "include"
                });

                // Redirige vers la page d'accueil
                window.location.href = "/";
            });
    </script>
</body>
</html>